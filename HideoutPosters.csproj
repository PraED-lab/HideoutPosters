<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>HideoutPosters</AssemblyName>
    <RootNamespace>HideoutPosters</RootNamespace>
    <Version>0.2.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2"><Private>false</Private><ExcludeAssets>runtime</ExcludeAssets></PackageReference>
    <PackageReference Include="SPTarkov.DI" Version="4.1.2"><Private>false</Private><ExcludeAssets>runtime</ExcludeAssets></PackageReference>
    <PackageReference Include="SPTarkov.Common" Version="4.1.2"><Private>false</Private><ExcludeAssets>runtime</ExcludeAssets></PackageReference>
  </ItemGroup>
</Project>
